APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_MAX_LOGIN_MINUTES=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Only if antivirus (e.g. Avast Mail Shield) intercepts mail TLS: a CA bundle that includes its root.
MAIL_CA_FILE=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Automatic check that uploaded IDs are real government IDs (Claude vision).
# Leave the key empty to skip the check (uploads are then flagged for admin review).
ANTHROPIC_API_KEY=
# ALVY Assistant (AI help chat on the shop pages) uses the key above; it stays hidden until the key is set.
ASSISTANT_ENABLED=true
ASSISTANT_DAILY_LIMIT=60
ID_CHECK_ENABLED=true

# Sign in with Google (Google Cloud OAuth client). While empty, the Google button explains it is not set up yet.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Optional: folder for public uploads shared with the app API (defaults to storage/app/public)
# PUBLIC_STORAGE_PATH="D:/path/to/Ecommerce.app/api/storage/app/public"

# Marketplace: platform commission % per sale (stored on each order line at checkout), and the
# store-wide low-stock alert level (each product can override it).
MARKETPLACE_COMMISSION=10
# ALVY's commission % on a sorting center's share of each shipping fee (SC "Commission & Earnings" page).
SORTING_CENTER_COMMISSION=10
LOW_STOCK_THRESHOLD=5

# GCash sent by the buyer to this number, proved with an uploaded receipt (shown at checkout only when set).
GCASH_NUMBER=
GCASH_ACCOUNT_NAME=

# Service area: comma-separated PSA province codes ALVY operates in (043400000 = Laguna).
# Empty = nationwide. See php artisan service-area:report for older records outside it.
SERVICE_AREA_PROVINCES=043400000

# Shipments: hours a dispatched hub-to-hub transfer may take before it is flagged as delayed.
LOGISTICS_TRANSFER_HOURS=24

# Forgot password: minutes a reset link stays valid, and seconds before another link can be sent to the same account.
# Reset emails link to APP_URL, so set APP_URL to the address people actually use (e.g. http://127.0.0.1:8000 or https://alvy.trade).
AUTH_PASSWORD_RESET_EXPIRE=60
AUTH_PASSWORD_RESET_THROTTLE=60

# AI chatbot (ALVY Assistant). Runs on Google Gemini: paste a key from https://aistudio.google.com/apikey
# then run: php artisan config:clear && php artisan assistant:check
ASSISTANT_PROVIDER=gemini
ASSISTANT_MODEL=gemini-3.8-flash
# Used when the main model is busy (comma-separated, tried in order)
ASSISTANT_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash
GEMINI_API_KEY=
